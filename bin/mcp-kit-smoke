#!/usr/bin/env bash
# Local Workers-runtime smoke harness: boot `wrangler dev` on a free port, wait
# for it to answer, run the given probe command with {port} substituted, then
# tear everything down. Generalized from the per-repo smoke-mcp.sh scripts.
#
#   mcp-kit-smoke -- node scripts/probe-mcp.mjs --endpoint "http://127.0.0.1:{port}/mcp"
#
# Run from the repo that owns wrangler.jsonc. Exits non-zero if wrangler never
# becomes ready or the probe fails.
set -euo pipefail

if [ "${1:-}" != "--" ] || [ "$#" -lt 2 ]; then
	echo "usage: mcp-kit-smoke -- <probe command with {port} placeholder>" >&2
	exit 2
fi
shift

LOG="$(mktemp -t wdev.XXXXXX)"
PORT="${PORT:-$(python3 - <<'PY'
import socket

with socket.socket() as s:
    s.bind(("127.0.0.1", 0))
    print(s.getsockname()[1])
PY
)}"

npx wrangler dev --port "$PORT" --ip 127.0.0.1 >"$LOG" 2>&1 &
WPID=$!
cleanup() {
	kill "$WPID" 2>/dev/null || true
	pkill -P "$WPID" 2>/dev/null || true
	echo "=== wrangler log ==="
	cat "$LOG"
	rm -f "$LOG"
}
trap cleanup EXIT

ready=0
secs=0
code=000
for i in $(seq 1 120); do
	code=$(curl -s -o /dev/null -w '%{http_code}' "http://127.0.0.1:${PORT}/mcp" 2>/dev/null || true)
	[ -z "$code" ] && code=000
	if [ "$code" != "000" ]; then
		ready=1
		secs=$i
		break
	fi
	if ! kill -0 "$WPID" 2>/dev/null; then
		echo "!! wrangler exited early"
		break
	fi
	sleep 1
done
echo "ready=$ready after ${secs}s (/mcp returned HTTP ${code} on port ${PORT})"

if [ "$ready" != "1" ]; then
	exit 1
fi

# Substitute {port} in every probe arg, then run the probe.
probe=()
for arg in "$@"; do
	probe+=("${arg//\{port\}/$PORT}")
done
"${probe[@]}"
