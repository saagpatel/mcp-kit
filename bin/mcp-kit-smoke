#!/usr/bin/env bash
# Run a consumer's probe against its local wrangler dev process.
set -Eeuo pipefail

LOG=""
MANAGER_PID=""
PROBE_PID=""
cleanup() {
	local status=$?
	trap - EXIT INT TERM
	if [[ -n "$PROBE_PID" ]] && kill -0 "$PROBE_PID" 2>/dev/null; then
		kill -TERM "$PROBE_PID" 2>/dev/null || true
		wait "$PROBE_PID" 2>/dev/null || true
	fi
	if [[ -n "$MANAGER_PID" ]] && kill -0 "$MANAGER_PID" 2>/dev/null; then
		kill -TERM "$MANAGER_PID" 2>/dev/null || true
		wait "$MANAGER_PID" 2>/dev/null || true
	fi
	if [[ -n "$LOG" && -f "$LOG" ]]; then
		echo "=== wrangler log ==="
		cat "$LOG"
		rm -f "$LOG"
	fi
	exit "$status"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

HELP='Usage: mcp-kit-smoke [--help] -- <probe command with {port} placeholder>
Requires Node.js, curl, and the consumer repository local wrangler install.
PORT optionally selects the local port; SMOKE_TIMEOUT_SECS sets the total deadline (default 120).'
if [[ "${1:-}" == "--help" && "$#" -eq 1 ]]; then echo "$HELP"; exit 0; fi
if [[ "${1:-}" != "--" || "$#" -lt 2 ]]; then echo "$HELP" >&2; exit 2; fi
shift

deadline="${SMOKE_TIMEOUT_SECS:-120}"
if ! [[ "$deadline" =~ ^[1-9][0-9]*$ ]]; then echo "SMOKE_TIMEOUT_SECS must be a positive integer" >&2; exit 2; fi
wrangler="./node_modules/.bin/wrangler"
if [[ ! -x "$wrangler" ]]; then
	echo "wrangler not found at $wrangler; install it in the consumer repo (for example: npm install --save-dev wrangler)" >&2
	exit 127
fi
LOG="$(mktemp "${TMPDIR:-/tmp}/mcp-kit-smoke.XXXXXX")"
if [[ -z "${PORT:-}" ]]; then
	PORT="$(node -e 'const net=require("node:net");const s=net.createServer();s.listen(0,"127.0.0.1",()=>{console.log(s.address().port);s.close()})')"
fi
if ! [[ "$PORT" =~ ^[0-9]+$ ]] || (( PORT < 1 || PORT > 65535 )); then echo "PORT must be a valid TCP port" >&2; exit 2; fi

# The small Node supervisor owns a detached process group, forwards termination,
# escalates after a grace period, and waits for the wrangler process to exit.
node -e '
const {spawn}=require("node:child_process");
const child=spawn(process.argv[1],["dev","--port",process.argv[2],"--ip","127.0.0.1"],{detached:true,stdio:"inherit"});
let stopping=false,spawnFailure=false;
child.on("error",e=>{console.error(e.message);spawnFailure=true});
child.on("close",(code,signal)=>{if(!stopping)process.exit(spawnFailure?127:(code??(signal?1:0)))});
const signal=signum=>{try{process.kill(-child.pid,signum)}catch{};try{child.kill(signum)}catch{}};
const stop=()=>{if(stopping)return;stopping=true;signal("SIGTERM");const timer=setTimeout(()=>signal("SIGKILL"),500);timer.unref();child.once("close",()=>{clearTimeout(timer);process.exit(0)})};
process.on("SIGTERM",stop);process.on("SIGINT",stop);
' "$wrangler" "$PORT" >"$LOG" 2>&1 &
MANAGER_PID=$!
SECONDS=0
ready=0
code=000
while (( SECONDS < deadline )); do
	code="$(curl --connect-timeout 1 --max-time 2 -s -o /dev/null -w '%{http_code}' "http://127.0.0.1:${PORT}/mcp" 2>/dev/null || true)"
	[[ -n "$code" ]] || code=000
	if [[ "$code" != 000 ]]; then ready=1; break; fi
	if ! kill -0 "$MANAGER_PID" 2>/dev/null; then echo "!! wrangler exited early" >&2; break; fi
	sleep 1
done
echo "ready=$ready after ${SECONDS}s (/mcp returned HTTP ${code} on port ${PORT})"
if [[ "$ready" != 1 ]]; then
	if (( SECONDS >= deadline )); then echo "smoke timed out after ${deadline}s" >&2; exit 124; fi
	exit 1
fi

probe=()
for arg in "$@"; do probe+=("${arg//\{port\}/$PORT}"); done
# The probe also gets an owned process group so interrupted or timed-out probes
# cannot leave grandchildren behind.
node -e '
const {spawn}=require("node:child_process");
const child=spawn(process.argv[1],process.argv.slice(2),{detached:true,stdio:"inherit"});
let stopping=false,spawnFailure=false;
child.on("error",e=>{console.error(e.message);spawnFailure=true});
child.on("close",(code,signal)=>{if(!stopping)process.exit(spawnFailure?127:(code??(signal?1:0)))});
const signal=signum=>{try{process.kill(-child.pid,signum)}catch{};try{child.kill(signum)}catch{}};
const stop=()=>{if(stopping)return;stopping=true;signal("SIGTERM");const timer=setTimeout(()=>signal("SIGKILL"),500);timer.unref();child.once("close",()=>{clearTimeout(timer);process.exit(0)})};
process.on("SIGTERM",stop);process.on("SIGINT",stop);
' "${probe[@]}" &
PROBE_PID=$!
while kill -0 "$PROBE_PID" 2>/dev/null; do
	if (( SECONDS >= deadline )); then echo "smoke timed out after ${deadline}s" >&2; exit 124; fi
	sleep 0.1
done
set +e
wait "$PROBE_PID"
status=$?
set -e
PROBE_PID=""
exit "$status"
